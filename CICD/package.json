{
  "name": "mcp-cicd",
  "version": "1.0.0",
  "description": "Local CI/CD orchestrator",
  "main": "mcp-server.js",
  "scripts": {
    "start:mcp": "node mcp-server.js",
    "start:mcp-cursor": "node mcp-cursor-server.js",
    "ci:local": "powershell -NoProfile -ExecutionPolicy Bypass -File ./ci.ps1",
    "deploy:local": "powershell -NoProfile -ExecutionPolicy Bypass -File ./deploy.ps1",
    "lint": "eslint . --ext .js",
    "lint:fix": "eslint . --ext .js --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --watchAll=false",
    "build": "if not exist dist mkdir dist && echo 'built' > dist/index.js",
    "validate": "npm run lint && npm run format:check && npm run test:ci"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.5",
    "express": "^4.18.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.3.1",
    "eslint": "^9.35.0",
    "jest": "^29.7.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2"
  }
}
